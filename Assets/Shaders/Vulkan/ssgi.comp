#version 450
#extension GL_GOOGLE_include_directive : require

// Screen-space GI trace, HALF resolution. Fires cosine-weighted hemisphere
// rays from each pixel, marches them through the G-buffer, and gathers
// radiance from the lit scene at each hit.
//
// Output units match the IBL irradiance map (which stores E/PI, see
// irradiance_convolution.frag) so the composite can subtract one for the
// other. rgb = mean radiance over the directions that HIT, a = hit fraction.
// Dividing by the hit count rather than the ray count is deliberate: the
// composite lerps toward the far-field term by 'a', which is exactly the
// "unknown directions look like the far field" assumption.

#include "screen_trace.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, rgba16f) uniform writeonly image2D ssgiRaw;
layout(set = 0, binding = 1) uniform sampler2D gViewPos;      // full res
layout(set = 0, binding = 2) uniform sampler2D gViewNormal;   // full res
layout(set = 0, binding = 3) uniform sampler2D sceneColor;    // hdrLit, post-skybox
// Linear view depth (positive, 0 = sky), full res — depth_pyramid.comp level 0.
// The march taps this and NOT gViewPos: 2 bytes per tap instead of 8, which is
// the difference between a 16 MB working set that lives in L2 at 4K and a 66 MB
// one that does not. See screen_trace.glsl.
layout(set = 0, binding = 5) uniform sampler2D linearDepth;
// A min-reduced level of the same pyramid — the march's conservative reject
// filter. See TraceScreenRay.
layout(set = 0, binding = 6) uniform sampler2D coarseDepth;

layout(set = 0, binding = 4) uniform SSGIUBO {
    mat4 projection;
    vec2 halfSize;
    vec2 _pad;
} ubo;

layout(push_constant) uniform Push {
    uint  frameIndex;     // rotates the sample sequence; the temporal pass averages
    int   rayCount;
    float maxDistance;    // view-space units a ray may travel
    float intensity;
} pc;

// Cost is linear in rayCount x TRACE_STEPS, and this trace is the single most
// expensive pass in the frame at 4K. 8 rather than 16: the march terminates at
// the first depth crossing, so halving the budget mostly costs REACH — long
// rays that would have found a distant hit now miss, and the composite falls
// back to the far-field (DDGI/IBL) term for those directions, which is exactly
// what its confidence weighting is built to do. Near-field bounce, which is
// what SSGI is actually for, is unaffected.
const int   TRACE_STEPS   = 8;
// Two bisections, not SSR's six. The hit UV here only picks whose radiance
// joins a cosine-weighted diffuse gather, so a few pixels of slop is invisible;
// on a scene where most rays hit, those four extra taps would be a quarter of
// the entire trace loop.
const int   REFINE_STEPS  = 2;
const float THICKNESS     = 0.6;
const float BIAS          = 0.05;
const float NORMAL_PUSH   = 0.05;   // lifts the origin off its own surface
const float FIREFLY_CLAMP = 8.0;    // one blown sample would persist forever

// pcg3d — cheap, well-distributed, and stable under the frameIndex rotation.
uvec3 PCG3D(uvec3 v) {
    v = v * 1664525u + 1013904223u;
    v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;
    v ^= v >> 16u;
    v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;
    return v;
}

vec2 Hash2(uvec2 pixel, uint ray, uint frame) {
    uvec3 h = PCG3D(uvec3(pixel, ray * 747796405u + frame * 2891336453u));
    return vec2(h.xy) * (1.0 / 4294967296.0);
}

// Branchless orthonormal basis (Duff et al.) — no degenerate case at n.z = -1.
void BuildBasis(vec3 n, out vec3 t, out vec3 b) {
    float s  = n.z >= 0.0 ? 1.0 : -1.0;
    float a  = -1.0 / (s + n.z);
    float ab = n.x * n.y * a;
    t = vec3(1.0 + s * n.x * n.x * a, s * ab, -s * n.x);
    b = vec3(ab, s + n.y * n.y * a, -n.y);
}

vec3 CosineSample(vec3 n, vec2 xi) {
    float r   = sqrt(xi.x);
    float phi = 6.28318530718 * xi.y;
    vec3 t, b;
    BuildBasis(n, t, b);
    return normalize(t * (r * cos(phi)) + b * (r * sin(phi))
                       + n * sqrt(max(0.0, 1.0 - xi.x)));
}

void main() {
    ivec2 id = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(vec2(id), ubo.halfSize))) return;

    // Every ray fires from an EXACT full-res texel, never a filtered one. The
    // previous origin — textureLod at the half-res texel centre — sat between
    // four full-res texels and got a BILINEAR blend of them, which across a
    // silhouette is a position and a normal belonging to no surface at all. It
    // also broke the composite's bilateral upsample, whose weights are computed
    // against the very G-buffer values this pass is supposed to have used.
    ivec2 fullSize = textureSize(gViewPos, 0);
    ivec2 scale    = max(ivec2(round(vec2(fullSize) / ubo.halfSize)), ivec2(1));
    ivec2 anchor   = min(id * scale, fullSize - 1);

    vec3 fragPos = texelFetch(gViewPos, anchor, 0).xyz;

    // Background pixel — no geometry written here.
    if (fragPos.z == 0.0) {
        imageStore(ssgiRaw, id, vec4(0.0));
        return;
    }

    vec3  normal = texelFetch(gViewNormal, anchor, 0).xyz;
    float nLenSq = dot(normal, normal);
    if (nLenSq <= 1e-6) {
        imageStore(ssgiRaw, id, vec4(0.0));
        return;
    }
    vec3 N = normal * inversesqrt(nLenSq);

    // Rotate WHICH texel of the footprint that is, one per frame. A fixed
    // anchor resamples the same sub-pixel forever, so the temporal pass
    // averages the same estimate over and over and everything between the
    // anchors is pure invention by the upsample filter; rotating turns the
    // accumulation into coverage of the whole footprint, which is what lets the
    // trace resolution drop without the result going blocky.
    //
    // The candidate is taken only if it lies on the SAME surface as the anchor.
    // Without that test a footprint straddling a silhouette would alternate
    // between two surfaces and accumulate their average — the exact cross-edge
    // bleeding the composite's bilateral weights exist to prevent, reintroduced
    // through the time axis where no spatial filter can see it.
    // The rotation is capped at a 2x2 sub-footprint no matter how large the
    // divisor gets. Rotating over the FULL footprint sounds better — more
    // coverage — but it is a bad trade: at a divisor of 4 it moves the origin up
    // to three texels between frames, and every one of those moves is a genuinely
    // different surface point whose GI differs, so the temporal pass sees a
    // signal that jumps every frame and has to absorb it. That is flicker. A
    // 2x2 cap still breaks the fixed-grid resampling that made the accumulation
    // pointless, at a per-frame origin delta of one texel.
    ivec2 jscale = min(scale, ivec2(2));
    int   lanes  = jscale.x * jscale.y;
    if (lanes > 1) {
        // Odd stride, so the four lanes are visited in a rotated order rather
        // than raster order; with four of them every step is still adjacent.
        int   j    = int((pc.frameIndex * 3u) % uint(lanes));
        ivec2 cand = min(anchor + ivec2(j % jscale.x, j / jscale.x), fullSize - 1);
        if (cand != anchor) {
            vec3  cp  = texelFetch(gViewPos,    cand, 0).xyz;
            vec3  cn  = texelFetch(gViewNormal, cand, 0).xyz;
            float cl2 = dot(cn, cn);
            if (cp.z != 0.0 && abs(cp.z - fragPos.z) <= 0.05 * abs(fragPos.z)
                && cl2 > 1e-6 && dot(cn * inversesqrt(cl2), N) >= 0.9) {
                fragPos = cp;
                N       = cn * inversesqrt(cl2);
            }
        }
    }

    vec3  origin = fragPos + N * NORMAL_PUSH;
    vec3  sum    = vec3(0.0);
    float hits   = 0.0;

    for (int i = 0; i < pc.rayCount; ++i) {
        vec3 dir = CosineSample(N, Hash2(uvec2(id), uint(i), pc.frameIndex));

        vec2 hitUV;
        if (!TraceScreenRay(linearDepth, coarseDepth, ubo.projection, origin, dir,
                            pc.maxDistance, TRACE_STEPS, REFINE_STEPS,
                            THICKNESS, BIAS, hitUV))
            continue;

        // Weight the sample by the edge fade instead of the radiance, so the
        // mean stays unbiased and confidence (not brightness) drops at borders.
        float w = EdgeFade(hitUV);
        if (w <= 0.0) continue;

        vec3 L = min(textureLod(sceneColor, hitUV, 0.0).rgb, vec3(FIREFLY_CLAMP));
        sum  += L * w;
        hits += w;
    }

    vec3  irradiance = hits > 0.0 ? (sum / hits) * pc.intensity : vec3(0.0);
    float confidence = hits / float(pc.rayCount);

    imageStore(ssgiRaw, id, vec4(irradiance, confidence));
}
